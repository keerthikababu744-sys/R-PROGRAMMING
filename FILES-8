data <- read.csv("students.csv")
cat("Student Data:\n")
print(data)
cat("Number of rows:", nrow(data), "\n")
cat("Number of columns:", ncol(data), "\n")
cat("Average Mark:", mean(data$Mark), "\n")
cat("Highest Mark:", max(data$Mark), "\n")
cat("Lowest Mark:", min(data$Mark), "\n")
cat("Total Mark:", sum(data$Mark), "\n")
cat("CSV analysis completed")
